# ========================================================
# Delta Traders — Gmail SMTP Configuration
# ========================================================

# The port where your SMTP backend server runs
PORT=5000

# Gmail SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=deltatraders.1620@gmail.com
TARGET_EMAIL=deltatraders.1620@gmail.com

# 16-Character Google App Password
# HOW TO GET THIS (Takes 1 minute):
# 1. Open https://myaccount.google.com/security on your deltatraders.1620@gmail.com account
# 2. Make sure "2-Step Verification" is ON
# 3. Visit https://myaccount.google.com/apppasswords
# 4. Type App name: "Delta Traders Website" and click "Create"
# 5. Copy the 16-character code (e.g. abcd efgh ijkl mnop) and paste it below:
SMTP_PASS=your_16_character_app_password_here

# Frontend API URL (leave as is for local development)
VITE_SMTP_API_URL=http://localhost:5000/api/send-email
